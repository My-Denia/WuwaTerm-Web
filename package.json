{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:selfhost": "WUWATERM_BUILD_TARGET=selfhost next build --webpack && node scripts/package-selfhost.mjs",
    "start:selfhost": "node scripts/start-selfhost.mjs",
    "package:selfhost-release": "node scripts/package-selfhost-release.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .next-selfhost --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test:feasibility": "node --test tests/feasibility.test.mjs",
    "test:product": "node --test tests/product-v1.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:built": "node scripts/check-built-artifact.mjs && node --test tests/built/*.test.mjs",
    "verify:no-client-secret": "node scripts/verify-no-client-secret.mjs",
    "test:contract": "node --test tests/contracts/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.38",
    "braces": "file:vendor/braces",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.4",
    "miniflare": "5.20260820.0-alpha",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vinext": "1.4.2",
    "vite": "8.3.5",
    "wrangler": "4.156.2",
    "minimatch": "file:vendor/minimatch-legacy"
  },
  "type": "module",
  "overrides": {
    "sharp": "0.35.5",
    "js-yaml": "4.3.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "undici": "7.30.1",
    "zod": "4.6.6",
    "fast-uri": "3.1.9",
    "braces": "$braces",
    "@vercel/og": "1.0.3",
    "fflate": "0.7.5",
    "minimatch": "$minimatch"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wuwaterm.local/contracts/manuscript.schema.json",
  "title": "WuwaTerm Manuscript Contract (v1–v4)",
  "oneOf": [
    { "$ref": "#/$defs/ManuscriptV1" },
    { "$ref": "#/$defs/ManuscriptV2" },
    { "$ref": "#/$defs/ManuscriptV3" },
    { "$ref": "#/$defs/ManuscriptV4" }
  ],
  "$defs": {
    "Direction": {
      "type": "string",
      "enum": ["en", "zh"]
    },
    "Verdict": {
      "type": "string",
      "enum": ["verified_constraint", "confirmed_conflict", "needs_review", "not_evaluated"]
    },
    "ReasonValue": {
      "type": "string",
      "enum": ["not_a_term", "ordinary_word", "no_target_region", "found_outside_region", "ambiguous_repeat"]
    },
    "ChoiceKind": {
      "type": "string",
      "enum": ["official_pair", "not_a_term"]
    },
    "RecordStatus": {
      "type": "string",
      "enum": ["pending", "done", "stale"]
    },
    "SegmentationVersion": {
      "type": "string",
      "const": "segmentation-v1"
    },
    "SemanticCategory": {
      "type": "string",
      "enum": [
        "omission",
        "unsupported_addition",
        "meaning_shift",
        "negation_change",
        "quantity_change",
        "reference_inconsistency",
        "term_sense"
      ]
    },
    "SemanticOrigin": {
      "type": "string",
      "enum": ["model"]
    },
    "SemanticConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "TermEffect": {
      "type": "string",
      "enum": ["none", "alters_official_match", "introduces_official_form", "not_checked"]
    },
    "SuggestionWithheldReason": {
      "type": "string",
      "enum": ["span_too_long", "replacement_too_long"]
    },
    "TruncatedReason": {
      "type": "string",
      "enum": ["issue_limit", "byte_limit"]
    },
    "SemanticResponseStatus": {
      "type": "string",
      "enum": ["complete", "not_reviewed"]
    },
    "SemanticDecisionKind": {
      "type": "string",
      "enum": ["accepted", "adjusted", "ignored"]
    },
    "WorkfileFormat": {
      "type": "string",
      "enum": [
        "wuwaterm-manuscript-v1",
        "wuwaterm-manuscript-v2",
        "wuwaterm-manuscript-v3",
        "wuwaterm-manuscript-v4"
      ]
    },
    "Hex64": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Hex32": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "text"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "CompactSpanTuple": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 1 }
      ],
      "items": false
    },
    "Alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/Span" },
        "target": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/Span" }
          ]
        }
      }
    },
    "CandidateSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "source_id"],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "CompactCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "zh", "en", "category"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/Hex64" },
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 }
      }
    },
    "CandidateV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en", "category", "sources"],
      "properties": {
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/CandidateSource" }
        }
      }
    },
    "CandidateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zh", "en", "category", "sources", "candidate_id"],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/Hex64" },
        "zh": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/CandidateSource" }
        }
      }
    },
    "DictionaryV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_commit", "term_count"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "source_commit": { "type": ["string", "null"] },
        "term_count": { "type": "integer", "minimum": 0 }
      }
    },
    "DictionaryV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_commit", "term_count", "revision"],
      "properties": {
        "schema_version": { "type": ["string", "null"] },
        "source_commit": { "type": ["string", "null"] },
        "term_count": { "type": "integer", "minimum": 0 },
        "revision": { "$ref": "#/$defs/Hex64" }
      }
    },
    "StrictDictionaryV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_commit", "term_count", "revision"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "source_commit": { "type": "string", "minLength": 1 },
        "term_count": { "type": "integer", "minimum": 0 },
        "revision": { "$ref": "#/$defs/Hex64" }
      }
    },
    "ReviewCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated", "not_evaluated", "rules"],
      "properties": {
        "evaluated": { "type": "integer", "minimum": 0 },
        "not_evaluated": { "type": "integer", "minimum": 0 },
        "rules": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "FindingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "verdict", "source_span", "target_span", "candidates", "candidates_truncated"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "source_span": { "$ref": "#/$defs/Span" },
        "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
        "candidates": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/CandidateV1" } },
        "candidates_truncated": { "type": "boolean" }
      }
    },
    "FindingV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "verdict", "source_span", "target_span", "candidates", "candidates_truncated"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rule_id": { "type": "string", "minLength": 1 },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "source_span": { "$ref": "#/$defs/Span" },
        "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
        "candidates": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/CandidateV2" } },
        "candidates_truncated": { "type": "boolean" }
      }
    },
    "FindingV4": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rule_id", "verdict", "source_span", "target_span", "candidates", "candidates_truncated"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "rule_id": { "type": "string", "minLength": 1 },
            "verdict": { "$ref": "#/$defs/Verdict" },
            "source_span": { "$ref": "#/$defs/Span" },
            "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
            "candidates": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/CandidateV2" } },
            "candidates_truncated": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "rule_id", "verdict", "source_span", "target_span", "candidates", "candidates_truncated", "reason"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "rule_id": { "type": "string", "minLength": 1 },
            "verdict": { "const": "not_evaluated" },
            "source_span": { "$ref": "#/$defs/Span" },
            "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
            "candidates": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/CandidateV2" } },
            "candidates_truncated": { "type": "boolean" },
            "reason": { "$ref": "#/$defs/ReasonValue" }
          }
        }
      ]
    },
    "ReportV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "source_revision", "target_revision", "rule_version", "dictionary", "coverage", "findings", "truncated"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_revision": { "$ref": "#/$defs/Hex64" },
        "target_revision": { "$ref": "#/$defs/Hex64" },
        "rule_version": { "const": "review-v1" },
        "matcher_revision": { "$ref": "#/$defs/Hex64" },
        "dictionary": { "$ref": "#/$defs/DictionaryV1" },
        "coverage": { "$ref": "#/$defs/ReviewCoverage" },
        "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/FindingV1" } },
        "truncated": { "type": "boolean" }
      }
    },
    "ReportV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "source_revision", "target_revision", "rule_version", "dictionary", "coverage", "findings", "truncated"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_revision": { "$ref": "#/$defs/Hex64" },
        "target_revision": { "$ref": "#/$defs/Hex64" },
        "rule_version": { "const": "review-v2" },
        "matcher_revision": { "$ref": "#/$defs/Hex64" },
        "dictionary": { "$ref": "#/$defs/DictionaryV2" },
        "coverage": { "$ref": "#/$defs/ReviewCoverage" },
        "findings": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/FindingV2" } },
        "truncated": { "type": "boolean" }
      }
    },
    "ReportV4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "source_revision", "target_revision", "rule_version", "dictionary", "coverage", "findings", "truncated"],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "source_revision": { "$ref": "#/$defs/Hex64" },
        "target_revision": { "$ref": "#/$defs/Hex64" },
        "rule_version": { "const": "review-v2" },
        "matcher_revision": { "$ref": "#/$defs/Hex64" },
        "dictionary": { "$ref": "#/$defs/DictionaryV2" },
        "coverage": { "$ref": "#/$defs/ReviewCoverage" },
        "findings": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/FindingV4" } },
        "truncated": { "type": "boolean" }
      }
    },
    "ChoiceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_version", "dictionary"],
      "properties": {
        "rule_version": { "const": "review-v2" },
        "dictionary": { "$ref": "#/$defs/DictionaryV2" },
        "matcher_revision": { "$ref": "#/$defs/Hex64" }
      }
    },
    "DocumentChoice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "direction", "source_span", "scope", "choice", "candidate", "basis"],
          "properties": {
            "source": { "type": "string" },
            "direction": { "$ref": "#/$defs/Direction" },
            "source_span": { "$ref": "#/$defs/Span" },
            "scope": { "type": "string" },
            "choice": { "const": "not_a_term" },
            "candidate": { "type": "null" },
            "basis": { "$ref": "#/$defs/ChoiceBasis" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "direction", "source_span", "scope", "choice", "candidate", "basis"],
          "properties": {
            "source": { "type": "string" },
            "direction": { "$ref": "#/$defs/Direction" },
            "source_span": { "$ref": "#/$defs/Span" },
            "scope": { "type": "string" },
            "choice": { "const": "official_pair" },
            "candidate": { "$ref": "#/$defs/CompactCandidate" },
            "basis": { "$ref": "#/$defs/ChoiceBasis" }
          }
        }
      ]
    },
    "Resolution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mention_id", "choice"],
          "properties": {
            "mention_id": { "type": "string", "minLength": 1 },
            "choice": { "const": "not_a_term" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mention_id", "choice", "candidate_id"],
          "properties": {
            "mention_id": { "type": "string", "minLength": 1 },
            "choice": { "const": "official_pair" },
            "candidate_id": { "$ref": "#/$defs/Hex64" }
          }
        }
      ]
    },
    "HistorySnapshotV1toV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "direction", "alignments", "report"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "direction": { "$ref": "#/$defs/Direction" },
        "alignments": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/Alignment" } }
          ]
        },
        "report": {
          "oneOf": [
            { "$ref": "#/$defs/ReportV1" },
            { "$ref": "#/$defs/ReportV2" }
          ]
        },
        "resolutions": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/Resolution" } }
      }
    },
    "HistorySnapshotV4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "direction", "alignments", "report"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "direction": { "$ref": "#/$defs/Direction" },
        "alignments": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/Alignment" } }
          ]
        },
        "report": {
          "oneOf": [
            { "$ref": "#/$defs/ReportV1" },
            { "$ref": "#/$defs/ReportV4" }
          ]
        },
        "resolutions": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/Resolution" } }
      }
    },
    "SemanticTermBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dictionary_revision", "matcher_revision"],
      "properties": {
        "dictionary_revision": { "$ref": "#/$defs/Hex64" },
        "matcher_revision": { "$ref": "#/$defs/Hex64" }
      }
    },
    "SemanticDecisionBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_version", "term_basis"],
      "properties": {
        "review_version": { "const": "semantic-review-v1" },
        "term_basis": { "$ref": "#/$defs/SemanticTermBasis" }
      }
    },
    "SemanticDecision": {
      "allOf": [
        {
          "anyOf": [
            { "required": ["source_span"], "properties": { "source_span": { "$ref": "#/$defs/Span" } } },
            { "required": ["target_span"], "properties": { "target_span": { "$ref": "#/$defs/Span" } } }
          ]
        },
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issue_id", "fingerprint", "category", "segment_index", "source_revision",
                "target_revision", "source_span", "target_span", "decision", "applied_text", "basis"
              ],
              "properties": {
                "issue_id": { "$ref": "#/$defs/Hex32" },
                "fingerprint": { "$ref": "#/$defs/Hex32" },
                "category": { "$ref": "#/$defs/SemanticCategory" },
                "segment_index": { "type": "integer", "minimum": 0 },
                "source_revision": { "$ref": "#/$defs/Hex64" },
                "target_revision": { "$ref": "#/$defs/Hex64" },
                "source_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "decision": { "const": "ignored" },
                "applied_text": { "type": "null" },
                "basis": { "$ref": "#/$defs/SemanticDecisionBasis" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "issue_id", "fingerprint", "category", "segment_index", "source_revision",
                "target_revision", "source_span", "target_span", "decision", "applied_text", "basis"
              ],
              "properties": {
                "issue_id": { "$ref": "#/$defs/Hex32" },
                "fingerprint": { "$ref": "#/$defs/Hex32" },
                "category": { "$ref": "#/$defs/SemanticCategory" },
                "segment_index": { "type": "integer", "minimum": 0 },
                "source_revision": { "$ref": "#/$defs/Hex64" },
                "target_revision": { "$ref": "#/$defs/Hex64" },
                "source_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "decision": { "enum": ["accepted", "adjusted"] },
                "applied_text": { "type": "string" },
                "basis": { "$ref": "#/$defs/SemanticDecisionBasis" }
              }
            }
          ]
        }
      ]
    },
    "SemanticText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "text"],
      "properties": {
        "revision": { "$ref": "#/$defs/Hex64" },
        "text": { "type": "string" }
      }
    },
    "SemanticSuggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_span", "replacement", "term_effect"],
      "properties": {
        "target_span": { "$ref": "#/$defs/Span" },
        "replacement": { "type": "string" },
        "term_effect": { "$ref": "#/$defs/TermEffect" }
      }
    },
    "SemanticAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement", "term_effect"],
      "properties": {
        "replacement": { "type": "string" },
        "term_effect": { "$ref": "#/$defs/TermEffect" }
      }
    },
    "SemanticIssue": {
      "allOf": [
        {
          "anyOf": [
            { "required": ["source_span"], "properties": { "source_span": { "$ref": "#/$defs/Span" } } },
            { "required": ["target_span"], "properties": { "target_span": { "$ref": "#/$defs/Span" } } }
          ]
        },
        {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "fingerprint", "category", "origin", "confidence", "source_span", "target_span",
                "source_excerpt", "target_excerpt", "rationale", "suggestion", "suggestion_withheld", "alternatives"
              ],
              "properties": {
                "id": { "$ref": "#/$defs/Hex32" },
                "fingerprint": { "$ref": "#/$defs/Hex32" },
                "category": { "$ref": "#/$defs/SemanticCategory" },
                "origin": { "$ref": "#/$defs/SemanticOrigin" },
                "confidence": { "$ref": "#/$defs/SemanticConfidence" },
                "source_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "source_excerpt": { "type": ["string", "null"] },
                "target_excerpt": { "type": ["string", "null"] },
                "rationale": { "type": "string" },
                "suggestion": { "type": "null" },
                "suggestion_withheld": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/SuggestionWithheldReason" }] },
                "alternatives": { "type": "array", "maxItems": 0, "items": { "$ref": "#/$defs/SemanticAlternative" } }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id", "fingerprint", "category", "origin", "confidence", "source_span", "target_span",
                "source_excerpt", "target_excerpt", "rationale", "suggestion", "suggestion_withheld", "alternatives"
              ],
              "properties": {
                "id": { "$ref": "#/$defs/Hex32" },
                "fingerprint": { "$ref": "#/$defs/Hex32" },
                "category": { "$ref": "#/$defs/SemanticCategory" },
                "origin": { "$ref": "#/$defs/SemanticOrigin" },
                "confidence": { "$ref": "#/$defs/SemanticConfidence" },
                "source_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "target_span": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Span" }] },
                "source_excerpt": { "type": ["string", "null"] },
                "target_excerpt": { "type": ["string", "null"] },
                "rationale": { "type": "string" },
                "suggestion": { "$ref": "#/$defs/SemanticSuggestion" },
                "suggestion_withheld": { "type": "null" },
                "alternatives": { "type": "array", "maxItems": 1, "items": { "$ref": "#/$defs/SemanticAlternative" } }
              }
            }
          ]
        }
      ]
    },
    "SemanticReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id", "review_version", "source_revision", "target_revision", "term_basis",
        "status", "status_reason", "dropped_unanchored", "checked", "issues",
        "truncated", "truncated_reason", "omitted_issues"
      ],
      "properties": {
        "request_id": { "type": "string", "minLength": 1 },
        "review_version": { "const": "semantic-review-v1" },
        "source_revision": { "$ref": "#/$defs/Hex64" },
